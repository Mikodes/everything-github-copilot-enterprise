{
  "name": "egce-memory-bank",
  "displayName": "EGCE Memory Bank",
  "description": "Visual Memory Bank management for Everything GitHub Copilot Enterprise",
  "version": "0.1.0",
  "publisher": "egce",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "copilot",
    "memory bank",
    "context",
    "enterprise",
    "java",
    "spring",
    "dotnet"
  ],
  "activationEvents": [
    "workspaceContains:.memory-bank",
    "onView:memoryBankExplorer",
    "onChatParticipant:egce.memory-bank",
    "onChatParticipant:egce.egce"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "egce.memory-bank",
        "fullName": "Memory Bank",
        "name": "memory-bank",
        "description": "Query your project's Memory Bank context directly from Copilot Chat. Search documentation, architecture decisions, patterns, and more.",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Search the Memory Bank for relevant context"
          },
          {
            "name": "context",
            "description": "Detect and show current working context"
          },
          {
            "name": "decisions",
            "description": "Search architecture decisions (ADRs)"
          },
          {
            "name": "patterns",
            "description": "Find patterns and best practices"
          },
          {
            "name": "help",
            "description": "Show Memory Bank help and available commands"
          }
        ]
      },
      {
        "id": "egce.egce",
        "fullName": "EGCE Assistant",
        "name": "egce",
        "description": "Enterprise GitHub Copilot Enhancement - Intelligent assistant with complete Memory Bank knowledge, team standards enforcement, and specialized agent access.",
        "isSticky": true,
        "commands": [
          {
            "name": "architect",
            "description": "Architecture mode - system design, ADRs, technical strategy"
          },
          {
            "name": "dev",
            "description": "Development mode - coding with patterns and standards"
          },
          {
            "name": "review",
            "description": "Review mode - code review with standards enforcement"
          },
          {
            "name": "context",
            "description": "Show loaded Memory Bank context"
          },
          {
            "name": "standards",
            "description": "Show team standards and conventions"
          },
          {
            "name": "help",
            "description": "Show EGCE help and available commands"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "egce.initProject",
        "title": "Initialize Memory Bank Project",
        "category": "EGCE",
        "icon": "$(folder-opened)"
      },
      {
        "command": "egce.updateContext",
        "title": "Update Context",
        "category": "EGCE",
        "icon": "$(sync)"
      },
      {
        "command": "egce.addDecision",
        "title": "Add Architecture Decision Record",
        "category": "EGCE",
        "icon": "$(lightbulb)"
      },
      {
        "command": "egce.selectAgent",
        "title": "Select Agent",
        "category": "EGCE",
        "icon": "$(person)"
      },
      {
        "command": "egce.refreshMemoryBank",
        "title": "Refresh Memory Bank",
        "category": "EGCE",
        "icon": "$(refresh)"
      },
      {
        "command": "egce.openContextFile",
        "title": "Open Context File",
        "category": "EGCE",
        "icon": "$(file)"
      },
      {
        "command": "egce.validateMemoryBank",
        "title": "Validate Memory Bank",
        "category": "EGCE",
        "icon": "$(check)"
      },
      {
        "command": "egce.createContextFile",
        "title": "Create Context File",
        "category": "EGCE",
        "icon": "$(new-file)"
      },
      {
        "command": "egce.toggleContextualHovers",
        "title": "Toggle Contextual Hovers",
        "category": "EGCE",
        "icon": "$(comment)"
      },
      {
        "command": "egce.clearHoverCache",
        "title": "Clear Hover Cache",
        "category": "EGCE",
        "icon": "$(trash)"
      },
      {
        "command": "egce.toggleAdrBadges",
        "title": "Toggle ADR Badges",
        "category": "EGCE",
        "icon": "$(eye)"
      },
      {
        "command": "egce.refreshAdrBadges",
        "title": "Refresh ADR Badges",
        "category": "EGCE",
        "icon": "$(refresh)"
      },
      {
        "command": "egce.navigateToAdrAtLine",
        "title": "Navigate to Related ADR",
        "category": "EGCE",
        "icon": "$(link-external)"
      },
      {
        "command": "egce.openAdrFromBadge",
        "title": "Open ADR",
        "category": "EGCE",
        "icon": "$(file)"
      },
      {
        "command": "egce.startCollaboration",
        "title": "Start Collaboration",
        "category": "EGCE",
        "icon": "$(broadcast)"
      },
      {
        "command": "egce.stopCollaboration",
        "title": "Stop Collaboration",
        "category": "EGCE",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "egce.showCollaborators",
        "title": "Show Collaborators",
        "category": "EGCE",
        "icon": "$(organization)"
      },
      {
        "command": "egce.goToCollaboratorCursor",
        "title": "Go to Collaborator Cursor",
        "category": "EGCE",
        "icon": "$(arrow-right)"
      },
      {
        "command": "egce.toggleCollaboratorCursors",
        "title": "Toggle Collaborator Cursors",
        "category": "EGCE",
        "icon": "$(eye)"
      },
      {
        "command": "egce.refreshCollaborators",
        "title": "Refresh Collaborators",
        "category": "EGCE",
        "icon": "$(refresh)"
      },
      {
        "command": "egce.openChatPanel",
        "title": "Open Team Chat",
        "category": "EGCE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "egce.quickChat",
        "title": "Quick Chat",
        "category": "EGCE",
        "icon": "$(comment)"
      },
      {
        "command": "egce.toggleCollaboration",
        "title": "Toggle Collaboration",
        "category": "EGCE",
        "icon": "$(broadcast)"
      },
      {
        "command": "egce.validateCode",
        "title": "Validate Code Against Patterns",
        "category": "EGCE",
        "icon": "$(checklist)"
      },
      {
        "command": "egce.generateAdr",
        "title": "Generate Architecture Decision Record",
        "category": "EGCE",
        "icon": "$(note)"
      },
      {
        "command": "egce.detectAdrRequirement",
        "title": "Detect ADR Requirement",
        "category": "EGCE",
        "icon": "$(search)"
      },
      {
        "command": "egce.showTemplates",
        "title": "Show Code Templates",
        "category": "EGCE",
        "icon": "$(file-code)"
      },
      {
        "command": "egce.getPatternRecommendations",
        "title": "Get Pattern Recommendations",
        "category": "EGCE",
        "icon": "$(lightbulb)"
      },
      {
        "command": "egce.generatePrContext",
        "title": "Generate PR Context",
        "category": "EGCE",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "egce.suggestReviewers",
        "title": "Suggest PR Reviewers",
        "category": "EGCE",
        "icon": "$(person-add)"
      },
      {
        "command": "egce.detectBreakingChanges",
        "title": "Detect Breaking Changes",
        "category": "EGCE",
        "icon": "$(warning)"
      },
      {
        "command": "egce.findRelatedAdrs",
        "title": "Find Related ADRs for Changes",
        "category": "EGCE",
        "icon": "$(references)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memoryBank",
          "title": "Memory Bank",
          "icon": "resources/memory-bank.svg"
        }
      ]
    },
    "views": {
      "memoryBank": [
        {
          "id": "memoryBankExplorer",
          "name": "Explorer",
          "icon": "$(folder)",
          "contextualTitle": "Memory Bank Explorer"
        },
        {
          "id": "memoryBankAgents",
          "name": "Agents",
          "icon": "$(person)",
          "contextualTitle": "Available Agents"
        },
        {
          "id": "memoryBankDecisions",
          "name": "Decisions (ADRs)",
          "icon": "$(lightbulb)",
          "contextualTitle": "Architecture Decision Records"
        },
        {
          "id": "memoryBankCollaborators",
          "name": "Collaborators",
          "icon": "$(organization)",
          "contextualTitle": "Team Collaborators"
        },
        {
          "id": "memoryBankChat",
          "name": "Team Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Quick Team Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "memoryBankExplorer",
        "contents": "No Memory Bank found in this workspace.\n[Initialize Memory Bank](command:egce.initProject)"
      },
      {
        "view": "memoryBankCollaborators",
        "contents": "Connect to see team collaborators.\n[Start Collaboration](command:egce.startCollaboration)"
      },
      {
        "view": "memoryBankChat",
        "contents": "Connect to start chatting with your team.\n[Start Collaboration](command:egce.startCollaboration)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "egce.refreshMemoryBank",
          "when": "view == memoryBankExplorer",
          "group": "navigation"
        },
        {
          "command": "egce.createContextFile",
          "when": "view == memoryBankExplorer",
          "group": "navigation"
        },
        {
          "command": "egce.refreshCollaborators",
          "when": "view == memoryBankCollaborators",
          "group": "navigation"
        },
        {
          "command": "egce.toggleCollaboratorCursors",
          "when": "view == memoryBankCollaborators",
          "group": "navigation"
        },
        {
          "command": "egce.openChatPanel",
          "when": "view == memoryBankChat",
          "group": "navigation"
        },
        {
          "command": "egce.quickChat",
          "when": "view == memoryBankChat",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "egce.openContextFile",
          "when": "view == memoryBankExplorer && viewItem == contextFile",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "egce.initProject"
        },
        {
          "command": "egce.updateContext"
        },
        {
          "command": "egce.addDecision"
        },
        {
          "command": "egce.selectAgent"
        },
        {
          "command": "egce.validateMemoryBank"
        },
        {
          "command": "egce.toggleContextualHovers"
        },
        {
          "command": "egce.clearHoverCache"
        },
        {
          "command": "egce.toggleAdrBadges"
        },
        {
          "command": "egce.refreshAdrBadges"
        },
        {
          "command": "egce.navigateToAdrAtLine"
        },
        {
          "command": "egce.startCollaboration"
        },
        {
          "command": "egce.stopCollaboration"
        },
        {
          "command": "egce.showCollaborators"
        },
        {
          "command": "egce.toggleCollaboratorCursors"
        },
        {
          "command": "egce.openChatPanel"
        },
        {
          "command": "egce.quickChat"
        },
        {
          "command": "egce.toggleCollaboration"
        },
        {
          "command": "egce.validateCode"
        },
        {
          "command": "egce.generateAdr"
        },
        {
          "command": "egce.detectAdrRequirement"
        },
        {
          "command": "egce.showTemplates"
        },
        {
          "command": "egce.getPatternRecommendations"
        },
        {
          "command": "egce.generatePrContext"
        },
        {
          "command": "egce.suggestReviewers"
        },
        {
          "command": "egce.detectBreakingChanges"
        },
        {
          "command": "egce.findRelatedAdrs"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "egce_project_context",
        "displayName": "EGCE Project Context",
        "description": "Provides complete project context from Memory Bank including patterns, standards, ADRs, and templates for Copilot Agent Mode",
        "canBeReferencedInPrompt": true,
        "tags": ["memory-bank", "context", "architecture"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "includePatterns": {
              "type": "boolean",
              "description": "Include architecture patterns in context"
            },
            "includeTemplates": {
              "type": "boolean",
              "description": "Include code templates in context"
            },
            "includeStandards": {
              "type": "boolean",
              "description": "Include team standards in context"
            },
            "currentFile": {
              "type": "string",
              "description": "Current file path for contextual loading"
            }
          }
        }
      },
      {
        "name": "egce_validate_code",
        "displayName": "EGCE Validate Code",
        "description": "Validates code against team standards and architecture patterns from Memory Bank",
        "canBeReferencedInPrompt": true,
        "tags": ["validation", "patterns", "standards"],
        "inputSchema": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": {
              "type": "string",
              "description": "Code to validate"
            },
            "language": {
              "type": "string",
              "description": "Programming language of the code"
            }
          }
        }
      },
      {
        "name": "egce_get_template",
        "displayName": "EGCE Get Template",
        "description": "Retrieves code templates from Memory Bank for code generation",
        "canBeReferencedInPrompt": true,
        "tags": ["templates", "generation", "code"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "templateId": {
              "type": "string",
              "description": "Specific template ID to retrieve"
            },
            "category": {
              "type": "string",
              "description": "Template category filter"
            }
          }
        }
      },
      {
        "name": "egce_search_patterns",
        "displayName": "EGCE Search Patterns",
        "description": "Searches architecture patterns in Memory Bank",
        "canBeReferencedInPrompt": true,
        "tags": ["patterns", "search", "architecture"],
        "inputSchema": {
          "type": "object",
          "required": ["query"],
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query for patterns"
            }
          }
        }
      },
      {
        "name": "egce_generate_adr",
        "displayName": "EGCE Generate ADR",
        "description": "Generates Architecture Decision Record drafts for architectural changes",
        "canBeReferencedInPrompt": true,
        "tags": ["adr", "architecture", "decisions"],
        "inputSchema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "description": "ADR title"
            },
            "context": {
              "type": "string",
              "description": "Context/problem statement"
            },
            "decision": {
              "type": "string",
              "description": "Decision made"
            },
            "positiveConsequences": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Positive consequences of the decision"
            },
            "negativeConsequences": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Negative consequences of the decision"
            }
          }
        }
      },
      {
        "name": "egce_pr_context",
        "displayName": "EGCE PR Context Generator",
        "description": "Generates rich context for Pull Requests including semantic diff analysis, related ADRs, pattern identification, reviewer suggestions, and breaking change detection (US-015)",
        "canBeReferencedInPrompt": true,
        "tags": ["pr", "pull-request", "context", "review"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "baseBranch": {
              "type": "string",
              "description": "Base branch for comparison (default: main)"
            },
            "includePatterns": {
              "type": "boolean",
              "description": "Detect and include patterns used or modified (default: true)"
            },
            "suggestReviewers": {
              "type": "boolean",
              "description": "Suggest reviewers based on module ownership (default: true)"
            },
            "detectBreakingChanges": {
              "type": "boolean",
              "description": "Detect potential breaking changes (default: true)"
            }
          }
        }
      },
      {
        "name": "egce_suggest_reviewers",
        "displayName": "EGCE Suggest Reviewers",
        "description": "Suggests PR reviewers based on module ownership and CODEOWNERS (AC-015.4)",
        "canBeReferencedInPrompt": true,
        "tags": ["pr", "review", "team"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "baseBranch": {
              "type": "string",
              "description": "Base branch for comparison (default: main)"
            },
            "maxReviewers": {
              "type": "number",
              "description": "Maximum number of reviewers to suggest (default: 5)"
            }
          }
        }
      },
      {
        "name": "egce_detect_breaking_changes",
        "displayName": "EGCE Detect Breaking Changes",
        "description": "Detects potential breaking changes in code modifications including API, schema, contract, and behavior changes (AC-015.5)",
        "canBeReferencedInPrompt": true,
        "tags": ["pr", "breaking-changes", "api", "compatibility"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "baseBranch": {
              "type": "string",
              "description": "Base branch for comparison (default: main)"
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "EGCE Memory Bank",
      "properties": {
        "egce.memoryBankPath": {
          "type": "string",
          "default": ".memory-bank",
          "description": "Path to the Memory Bank directory relative to workspace root"
        },
        "egce.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically validate Memory Bank files on save"
        },
        "egce.defaultStack": {
          "type": "string",
          "enum": [
            "java-spring",
            "dotnet",
            "generic"
          ],
          "default": "generic",
          "description": "Default technology stack for new projects"
        },
        "egce.showDecoratorIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show decorator icons in the Memory Bank tree view"
        },
        "egce.contextualHovers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable contextual hovers showing Memory Bank information when hovering over code symbols"
        },
        "egce.contextualHovers.showPatterns": {
          "type": "boolean",
          "default": true,
          "description": "Show design pattern information in contextual hovers"
        },
        "egce.contextualHovers.showDecisions": {
          "type": "boolean",
          "default": true,
          "description": "Show related Architecture Decision Records (ADRs) in contextual hovers"
        },
        "egce.contextualHovers.maxResults": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of context matches to show in hover tooltip"
        },
        "egce.contextualHovers.cacheTimeout": {
          "type": "number",
          "default": 180,
          "minimum": 30,
          "maximum": 600,
          "description": "Cache timeout for hover results in seconds"
        },
        "egce.adrBadges.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ADR badges in the editor gutter showing related Architecture Decision Records"
        },
        "egce.adrBadges.showProposed": {
          "type": "boolean",
          "default": true,
          "description": "Show badges for proposed (pending) ADRs"
        },
        "egce.adrBadges.showAccepted": {
          "type": "boolean",
          "default": true,
          "description": "Show badges for accepted ADRs"
        },
        "egce.adrBadges.showDeprecated": {
          "type": "boolean",
          "default": true,
          "description": "Show badges for deprecated ADRs"
        },
        "egce.adrBadges.showSuperseded": {
          "type": "boolean",
          "default": true,
          "description": "Show badges for superseded ADRs"
        },
        "egce.collaboration.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time collaboration features"
        },
        "egce.collaboration.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect to collaboration server on startup"
        },
        "egce.collaboration.showPresence": {
          "type": "boolean",
          "default": true,
          "description": "Show presence indicators for team members"
        },
        "egce.collaboration.showCursors": {
          "type": "boolean",
          "default": true,
          "description": "Show other users' cursor positions in the editor"
        },
        "egce.collaboration.showSelections": {
          "type": "boolean",
          "default": true,
          "description": "Show other users' text selections in the editor"
        },
        "egce.collaboration.enableChat": {
          "type": "boolean",
          "default": true,
          "description": "Enable contextual quick chat with team members"
        },
        "egce.collaboration.cursorUpdateDebounceMs": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 500,
          "description": "Debounce time in milliseconds for cursor position updates"
        },
        "egce.collaboration.presenceUpdateIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 10000,
          "maximum": 120000,
          "description": "Interval in milliseconds for presence updates"
        },
        "egce.collaboration.reconnectAttempts": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of reconnection attempts after connection loss"
        },
        "egce.collaboration.reconnectBackoffMs": {
          "type": "number",
          "default": 1000,
          "minimum": 500,
          "maximum": 5000,
          "description": "Base backoff time in milliseconds between reconnection attempts"
        },
        "egce.egce.defaultMode": {
          "type": "string",
          "enum": [
            "architect",
            "dev",
            "review"
          ],
          "default": "dev",
          "description": "Default operating mode for @egce chat participant"
        },
        "egce.egce.autoLoadContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically load Memory Bank context when starting a conversation"
        },
        "egce.egce.enforceStandards": {
          "type": "boolean",
          "default": true,
          "description": "Apply team standards in code suggestions and reviews"
        },
        "egce.egce.maxContextFiles": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 50,
          "description": "Maximum number of context files to load from Memory Bank"
        },
        "egce.egce.enabledAgents": {
          "type": "array",
          "default": [
            "architect",
            "code-reviewer",
            "security-auditor",
            "onboarding-guide",
            "knowledge-curator",
            "tech-debt-tracker",
            "performance-analyst",
            "adr-writer"
          ],
          "description": "List of enabled agent IDs for @egce participant",
          "items": {
            "type": "string"
          }
        },
        "egce.agentMode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Copilot Agent Mode integration"
        },
        "egce.agentMode.autoProvideContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically provide project context to Agent Mode"
        },
        "egce.agentMode.validateBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Validate code changes against patterns before applying"
        },
        "egce.agentMode.autoDetectAdr": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect when ADR is required for changes"
        },
        "egce.agentMode.includePatterns": {
          "type": "boolean",
          "default": true,
          "description": "Include architecture patterns in Agent Mode context"
        },
        "egce.agentMode.includeTemplates": {
          "type": "boolean",
          "default": true,
          "description": "Include code templates in Agent Mode context"
        },
        "egce.agentMode.validationStrictness": {
          "type": "string",
          "enum": ["relaxed", "moderate", "strict"],
          "default": "moderate",
          "description": "Strictness level for code validation"
        },
        "egce.agentMode.adrAutoGenerateThreshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.5,
